{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex State Kit",
  "version": "../package.json",
  "identifier": "io.codexstatekit.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev:renderer",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm icons && corepack pnpm build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex State Kit",
        "width": 900,
        "height": 680,
        "minWidth": 900,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "resources": { "resources/warp/": "warp/" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
